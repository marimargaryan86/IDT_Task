<?xml version="1.0" encoding="utf-8"?>
<!--
  The single place for run configuration; dotnet test picks it up through IDT_Task.csproj.
  An environment variable overrides a value for one run: BROWSER, HEADED=1 (Playwright's own) and IDT_BASE_URL,
  IDT_ACTION_TIMEOUT_MS (this project's, see Support/Settings.cs).
-->
<RunSettings>

  <!-- Read by Playwright's NUnit package. -->
  <Playwright>
    <!-- chromium | firefox | webkit (Chromium is the engine of Chrome and Edge). BROWSER=<name> overrides it. -->
    <BrowserName>chromium</BrowserName>
    <!-- Timeout for Expect(...) assertions, in ms -->
    <ExpectTimeout>10000</ExpectTimeout>
    <LaunchOptions>
      <!-- true = no browser window. HEADED=1 shows the browser for one run. -->
      <Headless>true</Headless>
      <!-- Slow every action down by this many ms, for watching a run. 0 = off. -->
      <SlowMo>0</SlowMo>
      <!-- Fail fast if the browser does not start (Playwright's default is 180000) -->
      <Timeout>60000</Timeout>
    </LaunchOptions>
  </Playwright>

  <!-- How many test classes run at the same time. 1 = sequential. More is faster but the site answers 503 more
       often under load. For one run, pass NUnit.NumberOfTestWorkers=4 after a double dash (see the README). -->
  <NUnit>
    <NumberOfTestWorkers>1</NumberOfTestWorkers>
  </NUnit>

  <TestRunParameters>
    <Parameter name="BaseUrl" value="https://automationexercise.com" />
    <!-- Timeout for actions and navigation (click, fill, goto), in ms -->
    <Parameter name="ActionTimeoutMs" value="30000" />
  </TestRunParameters>

</RunSettings>
